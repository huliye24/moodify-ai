{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MRS Validation Result",
  "type": "object",
  "required": [
    "mrs_version",
    "run_id",
    "decision",
    "tests"
  ],
  "properties": {
    "mrs_version": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "EXPERIMENTAL",
        "HOLD",
        "ADOPT",
        "DEPRECATED"
      ]
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "HOLD",
              "FAIL"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}