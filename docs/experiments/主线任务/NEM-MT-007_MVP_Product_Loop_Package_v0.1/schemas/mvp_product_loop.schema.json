{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moodify MVP Product Loop Record",
  "type": "object",
  "required": [
    "job_id",
    "import_id",
    "preset_id",
    "mrs_result_id",
    "export_id",
    "status"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "import_id": {
      "type": "string"
    },
    "preset_id": {
      "type": "string"
    },
    "mrs_result_id": {
      "type": "string"
    },
    "report_id": {
      "type": "string"
    },
    "export_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "completed",
        "failed"
      ]
    }
  }
}
