{
  "name": "moodify-qa-desktop",
  "version": "0.2.1",
  "description": "Moodify QA Desktop - Audio Quality Analysis Tool",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set NODE_ENV=development && electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "dist": "npm run build",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "audio",
    "quality",
    "analysis",
    "moodify",
    "qa"
  ],
  "author": "Moodify AI",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "form-data": "^4.0.6"
  },
  "build": {
    "appId": "com.moodify.qa.desktop",
    "productName": "Moodify QA Desktop",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../moodify-qa",
        "to": "backend",
        "filter": [
          "**/*",
          "!node_modules",
          "!__pycache__",
          "!*.pyc",
          "!.pytest_cache",
          "!tests"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.music",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
