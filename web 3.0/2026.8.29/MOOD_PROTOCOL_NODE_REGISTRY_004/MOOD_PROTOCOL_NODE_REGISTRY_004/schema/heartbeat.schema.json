{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mood://protocol/node-heartbeat/1.0.0",
  "title": "MOOD Node Health Observation",
  "type": "object",
  "required": [
    "nodeId",
    "observedAt",
    "source",
    "status",
    "protocolCompatible"
  ],
  "properties": {
    "nodeId": {
      "type": "string",
      "pattern": "^mood:node:[0-9a-f]{64}$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "healthy",
        "degraded",
        "unreachable",
        "unknown"
      ]
    },
    "protocolCompatible": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "latencyMs": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "reason": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    }
  },
  "additionalProperties": false
}
