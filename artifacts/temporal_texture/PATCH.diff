+        "task_id": task["task_id"],
+        "sample_id": sample_id,
+        "input_path": str(input_path),
+        "preset": preset,
+        "status": task["status"],
+        "return_code": (
+            "" if not chosen_result else chosen_result.get("return_code")
+        ),
+        "elapsed_seconds": (
