+    metrics = {
+        "gain_reduction_max_db": round(float(20 * np.log10(max(gain_reduction.min(), 1e-12))), 2),
+        "gain_reduction_avg_db": round(float(20 * np.log10(max(gain_reduction.mean(), 1e-12))), 2),
