+def _build_task_context(
+    cfg: RuntimeConfig,
+    run_id: str,
+    task: Dict[str, Any],
+    input_path: Path,
+    task_output_dir: Path,
+    preset: str,
+    sample_id: str,
+) -> Dict[str, Any]:
+    return {
+        "python": cfg.python,
+        "project_root": cfg.project_root,
+        "input": input_path,
+        "output_dir": task_output_dir,
+        "preset": preset,
+        "sample_id": sample_id,
+        "task_id": task["task_id"],
+        "run_id": run_id,
+    }
