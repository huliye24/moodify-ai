{
  "package_id": "MFY_ANDROID_AUDIO_PATH_OBSERVABILITY_001",
  "sequence": 68,
  "schema": "mfy-playback-path-v1",
  "schema_version": "v1",
  "source": "apps/android/app/src/main/java/com/moodify/app/data/PlaybackPath.kt (PlaybackPathRecord)",
  "honesty_rules": [
    "null = not observed/not available; no inference presented as measured fact",
    "NOT_OBSERVABLE = platform does not expose to apps (mixer post-format, AudioFocus passive state, offload detail)",
    "DERIVED = computed from observed format, not independently measured",
    "UNKNOWN = no signal received during observation window"
  ],
  "fields": [
    {"name": "schemaVersion", "type": "string", "kind": "constant", "notes": "mfy-playback-path-v1"},
    {"name": "recordId", "type": "string", "kind": "generated"},
    {"name": "uri", "type": "string|null", "kind": "observed", "notes": "content:/file:/http(s) URI as played"},
    {"name": "sourceKind", "type": "string", "kind": "derived", "values": ["LOCAL_CONTENT", "STREAMING_HTTP", "API_PATH"], "notes": "from URI scheme"},
    {"name": "containerFormat", "type": "string|null", "kind": "observed", "notes": "MediaExtractor mime → wav/flac/mp3/aac/ogg/amr"},
    {"name": "inputCodec", "type": "string|null", "kind": "observed", "notes": "MediaExtractor track 0 mime (audio/raw, audio/flac, audio/mpeg, audio/mp4...)"},
    {"name": "inputSampleRate", "type": "int|null", "kind": "observed", "notes": "MediaExtractor KEY_SAMPLE_RATE"},
    {"name": "inputBitDepth", "type": "int|null", "kind": "observed", "notes": "MediaExtractor KEY_PCM_ENCODING → 8/16/24/32; API 29+; float → null"},
    {"name": "inputChannels", "type": "int|null", "kind": "observed", "notes": "MediaExtractor KEY_CHANNEL_COUNT"},
    {"name": "decodedSampleRate", "type": "int|null", "kind": "observed", "notes": "ExoPlayer.getAudioFormat()"},
    {"name": "decodedChannels", "type": "int|null", "kind": "observed", "notes": "ExoPlayer.getAudioFormat()"},
    {"name": "decodedEncoding", "type": "string|null", "kind": "observed", "notes": "PCM_8BIT/16BIT/24BIT/32BIT/FLOAT"},
    {"name": "audioSessionId", "type": "int|null", "kind": "observed", "notes": "ExoPlayer.audioSessionId"},
    {"name": "audioAttributesUsage", "type": "string|null", "kind": "observed", "notes": "USAGE_1 (media) etc."},
    {"name": "audioTrackRequestedFormat", "type": "string|null", "kind": "derived", "notes": "decoded format as 'srHz/Nch/ENC'; ExoPlayer configures AudioTrack with it"},
    {"name": "audioTrackActualFormat", "type": "string", "kind": "constant", "values": ["NOT_OBSERVABLE"], "notes": "post-mixer write format not exposed by Media3 1.10.1 / Android"},
    {"name": "outputRoute", "type": "string|null", "kind": "observed", "notes": "AudioManager.getDevices(OUTPUTS) active sink productName"},
    {"name": "outputRouteDeviceType", "type": "string|null", "kind": "observed", "values": ["SPEAKER", "WIRED_HEADSET", "BLUETOOTH_A2DP", "BLUETOOTH_SCO", "USB_DAC", "HDMI", "TYPE_<n>"]},
    {"name": "systemOutputSampleRate", "type": "int|null", "kind": "observed", "notes": "PROPERTY_OUTPUT_SAMPLE_RATE (mixer side, post-resample)"},
    {"name": "systemFramesPerBuffer", "type": "int|null", "kind": "observed", "notes": "PROPERTY_OUTPUT_FRAMES_PER_BUFFER"},
    {"name": "spatializerActive", "type": "bool|null", "kind": "observed", "notes": "AudioManager.getSpatializer().isEnabled; API 33+, null below"},
    {"name": "audioFocusState", "type": "string", "kind": "constant", "values": ["NOT_OBSERVABLE"], "notes": "no passive focus API; observing would change behavior"},
    {"name": "underruns", "type": "int", "kind": "observed", "notes": "AnalyticsListener.onAudioUnderrun count"},
    {"name": "bufferedMs", "type": "long|null", "kind": "observed", "notes": "ExoPlayer bufferedPosition"},
    {"name": "playbackState", "type": "string|null", "kind": "observed", "values": ["IDLE", "BUFFERING", "READY", "ENDED"]},
    {"name": "offloadStatus", "type": "string", "kind": "observed", "values": ["OFFLOAD_ACTIVE", "FALLBACK_TO_AUDIOTRACK", "UNKNOWN"], "notes": "ExoPlayer.AudioOffloadListener; UNKNOWN = no callback fired"},
    {"name": "errorCode", "type": "string|null", "kind": "observed", "notes": "PlaybackException.errorCodeName"},
    {"name": "bypassReason", "type": "string|null", "kind": "constant", "notes": "NO_DSP_ACTIVE in 3.1 (no DSP in chain)"},
    {"name": "routeChanges", "type": "array", "kind": "observed", "notes": "[{type: DEVICE_ADDED/DEVICE_REMOVED, deviceType, atMs}]"},
    {"name": "createdAtMs", "type": "long", "kind": "generated"}
  ]
}
