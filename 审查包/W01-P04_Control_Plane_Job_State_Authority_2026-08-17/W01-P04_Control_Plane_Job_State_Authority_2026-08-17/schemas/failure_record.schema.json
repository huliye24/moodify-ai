{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Moodify Failure Record",
  "type": "object",
  "required": [
    "failure_id",
    "job_id",
    "attempt_id",
    "failure_class",
    "failure_code",
    "retryable",
    "occurred_at"
  ],
  "properties": {
    "failure_id": {
      "type": "string",
      "minLength": 1
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "failure_class": {
      "type": "string",
      "minLength": 1
    },
    "failure_code": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    },
    "stage": {
      "type": [
        "string",
        "null"
      ]
    },
    "component": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "safe_details_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}