{
  "$defs": {
    "AuthorityState": {
      "enum": [
        "SYSTEM",
        "ALGORITHM",
        "HUMAN_REQUIRED",
        "HUMAN_APPROVED",
        "HUMAN_REJECTED"
      ],
      "title": "AuthorityState",
      "type": "string"
    },
    "LifecycleState": {
      "enum": [
        "CREATED",
        "ACTIVE",
        "AWAITING_HUMAN",
        "COMPLETED",
        "FAILED",
        "CANCELLED"
