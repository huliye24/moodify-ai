# Moodify Environment Configuration Template
# Copy this file to .env and fill in your values

# ============================================
# Application Environment
# ============================================

# Environment: development, staging, production
MOODIFY_ENV=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
MOODIFY_LOG_LEVEL=INFO

# ============================================
# Data Paths
# ============================================

# Root path for data storage (inside container: /app/data)
MOODIFY_DATA_PATH=./data

# Temporary file path
MOODIFY_TEMP_PATH=./temp

# Model weights path
MOODIFY_MODEL_PATH=./models

# Cases storage path
MOODIFY_CASES_ROOT=./data/cases

# Node state directory
MOODIFY_NODE_STATE_DIR=./data/node

# Node output root
MOODIFY_NODE_OUTPUT_ROOT=./data/output

# ============================================
# API Configuration
# ============================================

# Maximum upload size in bytes (default: 50MB)
MOODIFY_MAX_UPLOAD_BYTES=52428800

# API host
MOODIFY_API_HOST=0.0.0.0

# API port
MOODIFY_API_PORT=8000

# Worker service URL
MOODIFY_WORKER_URL=http://localhost:8001

# ============================================
# Worker Configuration
# ============================================

# Number of worker threads
MOODIFY_WORKER_THREADS=4

# GPU support: true or false
MOODIFY_GPU_ENABLED=false

# Worker port
MOODIFY_WORKER_PORT=8001

# ============================================
# Audio Processing
# ============================================

# Default sample rate
MOODIFY_SAMPLE_RATE=44100

# Default audio format
MOODIFY_AUDIO_FORMAT=wav

# ============================================
# Security (Fill in production)
# ============================================

# API key for authentication (generate a strong key)
# MOODIFY_API_KEY=your-api-key-here

# JWT secret (generate a random string)
# MOODIFY_JWT_SECRET=your-jwt-secret-here

# Allowed hosts (comma-separated)
# MOODIFY_ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# External Services (Optional)
# ============================================

# Redis URL for queue (future)
# MOODIFY_REDIS_URL=redis://localhost:6379/0

# S3-compatible storage endpoint (future)
# MOODIFY_S3_ENDPOINT=https://s3.example.com
# MOODIFY_S3_BUCKET=moodify-data
# MOODIFY_S3_ACCESS_KEY=your-access-key
# MOODIFY_S3_SECRET_KEY=your-secret-key

# ============================================
# Monitoring (Optional)
# ============================================

# Prometheus metrics endpoint
# MOODIFY_METRICS_ENABLED=true
# MOODIFY_METRICS_PORT=9090

# Sentry DSN for error tracking
# SENTRY_DSN=your-sentry-dsn

# ============================================
# Development Only
# ============================================

# Enable hot reload (development only)
MOODIFY_RELOAD=false

# Debug mode (development only)
MOODIFY_DEBUG=false
