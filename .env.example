# ============================================================
# Moodify Pulse — 环境变量模板
# ============================================================
# 复制此文件为项目根目录的 .env 并填入你的实际值。
# Go 后端从当前工作目录加载 .env（通常在项目根目录运行）。
# Python AI 服务从 MOODIFY_ROOT 或项目根目录加载 .env。
# 此文件可以安全提交到 Git（不含真实密钥）。
# ============================================================

# --- Go 后端服务 ---
# 监听端口
SERVER_PORT=3001

# Gin 运行模式: debug | release | test
GIN_MODE=debug

# --- 数据库 ---
# 数据库类型（目前仅支持 sqlite）
DB_TYPE=sqlite

# SQLite 数据库文件路径（相对于 backend/ 目录）
DB_PATH=./data/moodify.db

# --- DeepSeek AI（可选）---
# 留空则使用模拟数据，核心功能不受影响
DEEPSEEK_API_KEY=

# DeepSeek 模型名称
DEEPSEEK_MODEL=deepseek-chat

# DeepSeek API 地址
DEEPSEEK_URL=https://api.deepseek.com/v1/chat/completions

# ============================================================
# 注意：
# - .env 已在 .gitignore 中，不会被提交
# - 从 backend/ 目录运行 Go 服务时，需在 backend/ 下放置 .env
# - Python 服务可用 MOODIFY_ROOT 指定项目根目录
# - 前端环境变量在 moodify-pulse/.env.local（如需要）
# ============================================================
# --- Moodify Python Path Config ---
# Project root directory (auto-detected if not set)
MOODIFY_ROOT=

# Output directory for processed audio and reports
MOODIFY_OUTPUT=

# Test audio directory for baseline tests
MOODIFY_TEST_AUDIO=
MOODIFY_CLOUD_HOST=43.156.175.4
MOODIFY_CLOUD_USER=ubuntu
MOODIFY_CLOUD_PASSWORD=
MOODIFY_CLOUD_DATA_DIR=cloud_data
