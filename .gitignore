# Product UI source (required by moodify_runtime.operator_api)
!moodify_runtime/operator_console.html

# Ear workbench pages are canonical app source (MFY_RELEASE_CANDIDATE_INTEGRITY_001)
!apps/ear-workbench/*.html

# Official website pages are canonical static source (MFY_DEEPSEEK_INDEPENDENT_RELEASE_VERIFICATION_001)
!ops/web_origin/site/rongjingmusic/*.html

# Music platform source and lightweight brand asset are canonical app inputs.
!apps/music-web/public/moodify-logo.png

# Keep baseline test audio (used by tests and calibration)
!moodify-core-package/tests/baseline/test_audio/*.wav

# Keep lightweight treatment records (JSON/MD only)
!treatment_records/
!treatment_records/*.json
!treatment_records/*.md

