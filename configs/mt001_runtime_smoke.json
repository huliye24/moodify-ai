{
  "project_root": ".",
  "data_root": "data/moodify_runtime_mt001",
  "input_dirs": [
    "moodify-core-package/tests/baseline/test_audio"
  ],
  "output_root": "outputs/mt001_smoke",
  "registry_path": "data/moodify_runtime_mt001/input_registry.jsonl",
  "queue_path": "data/moodify_runtime_mt001/run_queue.jsonl",
  "craft_memory_dir": "data/moodify_runtime_mt001/craft_memory",
  "report_dir": "reports/mt001_smoke",
  "presets": [
    "warm_vocal",
    "clean_master",
    "wide_space"
  ],
  "max_files": 3,
  "recurse": false,
  "timeout_seconds_per_task": 300,
  "sleep_seconds_between_tasks": 0.2,
  "max_retries_per_task": 0,
  "keep_last_n_runs": 5,
  "min_free_disk_gb": 1.0,
  "python": ".venv/bin/python",
  "stop_on_first_success_template": true,
  "audio_suffixes": [
    ".wav"
  ],
  "metric_audio_suffixes": [
    ".wav"
  ],
  "command_templates": [
    "{python} -m moodify.cli process {input} --preset {preset} --output-dir {output_dir}"
  ],
  "env": {
    "PYTHONUNBUFFERED": "1",
    "MOODIFY_MT001_SMOKE": "1"
  },
  "allow_missing_outputs": false
}
