{
  "project_root": ".",
  "data_root": "data/moodify_runtime_full_test",
  "input_dirs": [
    "data/night_inputs"
  ],
  "output_root": "outputs/full_test_v02",
  "registry_path": "data/moodify_runtime_full_test/input_registry.jsonl",
  "queue_path": "data/moodify_runtime_full_test/run_queue.jsonl",
  "craft_memory_dir": "data/moodify_runtime_full_test/craft_memory",
  "report_dir": "reports/runtime_v02",
  "presets": [
    "warm_vocal",
    "clean_master",
    "wide_space"
  ],
  "max_files": 30,
  "recurse": false,
  "timeout_seconds_per_task": 900,
  "sleep_seconds_between_tasks": 2,
  "max_retries_per_task": 1,
  "keep_last_n_runs": 3,
  "min_free_disk_gb": 1.0,
  "python": "python3",
  "stop_on_first_success_template": true,
  "audio_suffixes": [
    ".wav",
    ".mp3",
    ".flac",
    ".m4a",
    ".aac",
    ".ogg"
  ],
  "command_templates": [
    "{python} -m moodify.cli process {input} --preset {preset} --output-dir {output_dir}"
  ],
  "env": {
    "PYTHONUNBUFFERED": "1",
    "MOODIFY_FULL_TEST_V02": "1"
  },
  "allow_missing_outputs": true
}
