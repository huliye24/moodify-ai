{
  "project_root": ".",
  "data_root": "data/moodify_runtime",
  "input_dirs": [
    "data/night_inputs"
  ],
  "output_root": "outputs/daily_runs",
  "registry_path": "data/moodify_runtime/input_registry.jsonl",
  "queue_path": "data/moodify_runtime/run_queue.jsonl",
  "craft_memory_dir": "data/moodify_runtime/craft_memory",
  "report_dir": "reports/daily_runs",
  "presets": [
    "warm_vocal",
    "clean_master",
    "wide_space"
  ],
  "max_files": 30,
  "recurse": false,
  "timeout_seconds_per_task": 900,
  "sleep_seconds_between_tasks": 2,
  "max_retries_per_task": 2,
  "keep_last_n_runs": 10,
  "min_free_disk_gb": 1.0,
  "python": "python3",
  "stop_on_first_success_template": true,
  "audio_suffixes": [
    ".wav",
    ".mp3",
    ".flac",
    ".m4a",
    ".aac",
    ".ogg"
  ],
  "command_templates": [
    "{python} cli.py process --input {input} --output {output_dir} --preset {preset}",
    "{python} -m moodify.cli process --input {input} --output {output_dir} --preset {preset}",
    "{python} cli.py process {input} --output {output_dir} --preset {preset}"
  ],
  "env": {
    "PYTHONUNBUFFERED": "1",
    "MOODIFY_DAILY_RUN": "1"
  },
  "allow_missing_outputs": true
}