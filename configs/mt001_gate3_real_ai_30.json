{
  "project_root": ".",
  "data_root": "data/moodify_runtime_mt001_gate3",
  "input_dirs": [
    "data/mt001_real_inputs"
  ],
  "output_root": "outputs/mt001_gate3_real_ai",
  "registry_path": "data/moodify_runtime_mt001_gate3/input_registry.jsonl",
  "queue_path": "data/moodify_runtime_mt001_gate3/run_queue.jsonl",
  "craft_memory_dir": "data/moodify_runtime_mt001_gate3/craft_memory",
  "report_dir": "reports/mt001_gate3_real_ai",
  "presets": [
    "warm_vocal",
    "clean_master",
    "wide_space"
  ],
  "max_files": 30,
  "recurse": false,
  "timeout_seconds_per_task": 600,
  "sleep_seconds_between_tasks": 0.2,
  "max_retries_per_task": 1,
  "keep_last_n_runs": 5,
  "min_free_disk_gb": 5.0,
  "python": ".venv/bin/python",
  "stop_on_first_success_template": true,
  "audio_suffixes": [
    ".mp3",
    ".flac"
  ],
  "metric_audio_suffixes": [
    ".wav",
    ".mp3",
    ".flac"
  ],
  "command_templates": [
    "{python} -m moodify.cli process {input} --preset {preset} --output-dir {output_dir}"
  ],
  "env": {
    "PYTHONUNBUFFERED": "1",
    "MOODIFY_MT001_GATE3": "1"
  },
  "allow_missing_outputs": false
}
